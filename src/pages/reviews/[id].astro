---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map(review => ({
    params: { id: review.id },
    props: { review },
  }));
}

const { review } = Astro.props;
const { Content } = await render(review);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{review.data.title} | PipelineSaaSFi</title>
    <meta name="description" content={review.data.description}>

    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-QRDV52HC7K"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-QRDV52HC7K');
    </script>

    <!-- Carregamento do CSS global da pasta public/ -->
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <!-- Cabeçalho -->
    <header class="navbar">
        <div class="container navbar-content">
            <a href="/" class="logo" aria-label="PipelineSaaSFi home">
                Pipeline<span>SaaS</span>Fi
            </a>
            <nav class="main-nav">
                <a href="/#reviews">Reviews</a>
                <a href="/#comparisons">Comparisons</a>
                <a href="/#guides">Buying Guides</a>
                <a href="/#about">About</a>
                <a href="/contact">Contact</a>
            </nav>
        </div>
    </header>

    <!-- Conteúdo da Review -->
    <main class="container content-section" style="padding-top: 40px; max-width: 900px; margin: 0 auto;">
        <article class="review-article">
            <div class="card-badge" style="display: inline-block; margin-bottom: 15px;">{review.data.badge}</div>
            <h1 style="font-size: 2.5rem; line-height: 1.2; margin-bottom: 15px;">{review.data.title}</h1>
            
            <div class="card-details" style="margin-bottom: 30px; font-size: 0.9rem; color: #666;">
                <span>Updated: {review.data.updatedDate}</span> • 
                <span>{review.data.readTime}</span> • 
                <span>Rating: ★ {review.data.rating} / 5</span>
            </div>

            <hr style="border: 0; border-top: 1px solid #eee; margin-bottom: 30px;" />

            <!-- Corpo da Matéria formatado -->
            <div class="article-body">
                <Content />
            </div>
        </article>
    </main>

    <!-- Rodapé -->
    <footer class="footer">
        <div class="container footer-bottom">
            <p>&copy; 2026 PipelineSaaSFi. All rights reserved.</p>
        </div>
    </footer>

    <!-- Estilos globais para formatar o texto gerado do Markdown com !important -->
    <style is:global>
      .article-body {
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif !important;
        color: #2d3748 !important;
        font-size: 1.125rem !important;
        line-height: 1.8 !important;
      }

      .article-body h2 {
        font-size: 1.8rem !important;
        font-weight: 700 !important;
        color: #1a202c !important;
        margin-top: 2.5rem !important;
        margin-bottom: 1rem !important;
        padding-bottom: 0.5rem !important;
        border-bottom: 1px solid #e2e8f0 !important;
        display: block !important;
      }

      .article-body h3 {
        font-size: 1.4rem !important;
        font-weight: 600 !important;
        color: #2d3748 !important;
        margin-top: 2rem !important;
        margin-bottom: 0.75rem !important;
        display: block !important;
      }

      .article-body p {
        margin-bottom: 1.5rem !important;
        font-size: 1.125rem !important;
        line-height: 1.8 !important;
      }

      .article-body ul, .article-body ol {
        margin-bottom: 1.5rem !important;
        padding-left: 2rem !important;
        display: block !important;
      }

      .article-body li {
        margin-bottom: 0.5rem !important;
        list-style-type: disc !important;
      }

      .article-body blockquote {
        border-left: 4px solid #3182ce !important;
        background-color: #ebf8ff !important;
        padding: 1rem 1.25rem !important;
        margin: 1.5rem 0 !important;
        border-radius: 0 0.375rem 0.375rem 0 !important;
        font-style: italic !important;
      }

      .article-body strong {
        color: #1a202c !important;
        font-weight: 600 !important;
      }

      .article-body a {
        color: #3182ce !important;
        text-decoration: underline !important;
      }

      .article-body a:hover {
        color: #2b6cb0 !important;
      }

      .article-body table {
        width: 100% !important;
        border-collapse: collapse !important;
        margin: 2rem 0 !important;
      }

      .article-body th, .article-body td {
        border: 1px solid #e2e8f0 !important;
        padding: 0.75rem 1rem !important;
        text-align: left !important;
      }

      .article-body th {
        background-color: #f7fafc !important;
        font-weight: 600 !important;
      }
    </style>
</body>
</html>